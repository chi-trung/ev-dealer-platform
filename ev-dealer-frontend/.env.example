# API Base URL — points at the API Gateway (APIGatewayService, port 5036).
# The gateway routes /api/* to every microservice (see
# ev-dealer-management/docs/GATEWAY.md); the frontend should never need
# per-service URLs. The trailing /api is part of the base URL.
VITE_API_BASE_URL=http://localhost:5036/api

# Firebase (src/firebase/firebaseConfig.js, messaging.js)
#
# These seven values are PUBLIC by design — Firebase ships them in every web
# app. They are read from env so the app and the generated service worker
# share ONE copy: the worker is written by the plugin in vite.config.js and
# gets its config from exactly these vars. Leave them empty and push
# notifications silently do nothing (both the app and the worker log which
# fields are unset); a stale hard-coded copy in the worker used to keep
# delivering through the OLD project after this file was repointed.
#
# The VAPID key is a separate secret-ish value: it authorises push
# subscription for this web app. Keep it out of the repo, and rotate it in
# the Firebase console if it leaks.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# App Configuration
VITE_APP_NAME=EV Dealer Management
VITE_APP_VERSION=1.0.0

# Optional: Analytics, etc.
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_SENTRY_DSN=
