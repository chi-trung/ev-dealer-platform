# ── IDE ──────────────────────────────────────────────
.idea/
.vs/
.vscode/
*.user
*.suo

# ── .NET build output ────────────────────────────────
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.dll
*.exe
*.pdb
publish/

# ── Node / frontend ──────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*

# ── Environment & secrets ────────────────────────────
.env
.env.*
!.env.example
# Firebase service account key for NotificationService (Firebase:CredentialPath).
# It is mounted into the container at runtime; committing it would leak a
# credential with FCM send + project access. Pattern also matches the
# self-documented location in NotificationService/FIREBASE_SETUP.md.
firebase-credentials.json

# ── Databases & logs ─────────────────────────────────
*.db
*.db-shm
*.db-wal
*.log

# ── Test output ──────────────────────────────────────
TestResults/
*.trx

# ── OS ───────────────────────────────────────────────
Thumbs.db
.DS_Store

# ── Local scratch & tool caches (never commit) ─────────
_scratch/
.vercel/

# Agent/tooling state, not source. Nothing under either path is tracked, so
# ignoring them cannot drop anything already in history.
# .claude/ holds per-repo plan files; they are working notes about the code,
# not the code. Committing them would put that reasoning in the review surface
# and in every clone, and they go stale against the tree they describe.
.claude/
# .impeccable/ is design-detector state (ignore rules the tooling wrote for
# itself). It is machine-owned and rewrites itself; a diff on it is noise.
.impeccable/
