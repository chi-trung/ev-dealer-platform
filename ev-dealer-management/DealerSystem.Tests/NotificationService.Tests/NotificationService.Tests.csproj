<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Test SDK generates the entry point; the referenced web apps' top-level
         Program.Main stays ignored (one entry point wins, CS0017-avoidance). -->
    <GenerateProgramFile>true</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- Highest version across the referenced apps (UserService pins EF Sqlite
         8.0.10; the other four pin 8.0.0). NuGet "highest wins" resolves the
         whole graph to 8.0.10, so referencing it directly here avoids the
         NU1605 downgrade error without lowering any service's own pin. Used
         by the registry tests: real SQLite temp FILE dbs (NOT the InMemory
         test provider — only a real SQLite db enforces the unique (Key,
         Token) index, which is the dedupe guarantee under test). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Consumer + retry policy under test. -->
    <ProjectReference Include="..\..\NotificationService\NotificationService.csproj" />
    <!-- Real producer assemblies: the contract tests reference the producer
         event types BY NAME, so renaming a field on either side fails to
         compile. That compile-time coupling is the point. -->
    <ProjectReference Include="..\..\VehicleService\VehicleService.csproj" />
    <ProjectReference Include="..\..\CustomerService\CustomerService.csproj" />
    <ProjectReference Include="..\..\SalesService\SalesService.csproj" />
    <!-- Issue #41: the dealer-claim minting test runs the REAL UserServiceImpl
         against a temp SQLite UserDbContext and reads the claims back out of
         the JWT it returns. -->
    <ProjectReference Include="..\..\UserService\UserService.csproj" />
  </ItemGroup>

</Project>
