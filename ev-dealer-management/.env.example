# Local dev secrets for docker-compose.yml — copy to `.env` (gitignored, never commit real values).
# Compose reads ev-dealer-management/.env automatically.
#
# Gmail SMTP app password for UserService password-reset mail
# (Issue #10: no real credential may live in tracked files).
# Unset/empty => SMTP auth fails closed (check UserService logs);
# forgot-password still returns generic success to the client.
EMAIL_SMTP_PASSWORD=your-app-password
