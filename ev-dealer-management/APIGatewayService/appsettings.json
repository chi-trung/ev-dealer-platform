{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    // Downstream host rewrites applied to ocelot.json at startup, keyed by the
    // host written in the file. Local dev needs none (everything is localhost);
    // docker-compose sets e.g. { "Gateway": { "Hosts": { "localhost": "evm_userservice" } } }
    // only if compose ever puts the gateway behind service names. See docs/GATEWAY.md.
    "Hosts": {}
  }
}
