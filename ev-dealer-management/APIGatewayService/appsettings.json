{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/api-gateway-service-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    // Downstream endpoint rewrites applied to ocelot.json at startup. Keys are
    // full "host:port" authorities; values are "host:port" or scheme-qualified
    // "http(s)://host[:port]" (Issue #78; containers listen on 80/8080, not the
    // dev ports). Local dev needs none; docker-compose sets,
    // per service: { "From": "localhost:7001", "To": "userservice:80" }.
    // Env form: Gateway__Rewrites__0__From / Gateway__Rewrites__0__To.
    // The ':' character is illegal in config keys, which is why this is a
    // list of pairs, not a map. See docs/GATEWAY.md.
    "Rewrites": []
  }
}
